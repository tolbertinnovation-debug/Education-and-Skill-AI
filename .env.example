# Required: your OpenAI API key (kept on the server, never sent to the browser)
OPENAI_API_KEY=sk-...

# Optional: model to use (any Responses-API model your key can access)
OPENAI_MODEL=gpt-5-mini

# Optional: port for the web server
PORT=3000

# Optional: if set, users must enter this code in the app before using it.
# Strongly recommended when the app is reachable on the public internet,
# since every request is billed to your OpenAI account.
APP_ACCESS_CODE=

# Optional: requests allowed per IP per minute (default 20)
RATE_LIMIT_PER_MINUTE=20

# Optional: branding for the study-abroad module's call to action
ORG_NAME=TIH
ORG_CONTACT_URL=
